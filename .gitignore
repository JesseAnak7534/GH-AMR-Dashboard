# Python virtual environment
venv/
env/
ENV/
.env

# Streamlit secrets (API keys, DB URLs -- never commit)
.streamlit/secrets.toml

# Database files
db/amr_data.db
db/*.sqlite
db/*.sqlite3
# Lab credentials (plaintext passwords -- never commit)
db/lab_credentials.json
# Full database backups. Unlike db/cloud_snapshot.json.gz, which covers only
# surveillance tables, these dump every public table including `users` and so
# carry password hashes. They stay local.
db/supabase_pre_upgrade_*.json.gz
db/*_backup_*.json.gz
Lab_Login_Credentials.docx
# db/lab_accounts.json was deleted, not ignored. It paired each lab's code
# with its bcrypt hash, and the repository is public, so it handed an attacker
# both halves of the guess. Per-laboratory logins were retired with it.
db/lab_accounts.json

# Excel files and templates (keep templates, ignore uploads)
*.xlsx
*.xls
!templates/*.xlsx

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Archive folder (old docs, generators, personal files)
_archive/

# Generated reports and data
*.html

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Distribution
build/
dist/
*.egg-info/

# Temporary files
tmp/
temp/
~$*
*.tmp

# Personal / non-app files (CV, motivation letters, helper scripts)
.claude/
*CV*.docx
Motivation_Letter_*.docx
generate_motivation_letter.py
generate_egli_motivation_letter.py
generate_seeger_motivation_letter.py
read_cv.py
read_cv2.py
update_cv_about.py
CV for me/
"CV for me"/

# Thesis reference papers (large PDFs — not part of the app)
Thesis_Papers/

# PhD proposal drafts and sources (personal)
Proposal/

# Stray Windows shortcuts
*.lnk
